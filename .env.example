# Everything is optional. The app does not read .env files itself: export these in your shell or set
# them in your hosting provider. Invalid values stop the app at startup with a clear message.

# --- AI explanations (optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
EXPLAIN_DAILY_CAP=2000            # max live model calls per UTC day (0 = unlimited); cached answers are free
EXPLAIN_TIMEOUT_S=15
EXPLAIN_MAX_CONCURRENT=4          # calls in flight at once; extra requests get the built-in explanation
EXPLAIN_BREAKER_THRESHOLD=5       # consecutive failures before pausing model calls ...
EXPLAIN_BREAKER_COOLDOWN_S=60     # ... for this long

# --- Storage ---
DB_PATH=./readiness.db
DB_BUSY_TIMEOUT_S=5
MAX_ATTEMPTS_PER_LEARNER=10000

# --- Edge protection ---
TRUSTED_PROXY_HOPS=0              # 1 when behind exactly one proxy (Render, Fly, Heroku); 0 when exposed directly
RATE_LIMIT_PER_MIN=240            # per client, all /api routes (0 = off)
HEAVY_RATE_LIMIT_PER_MIN=12       # import / export / reset / demo
EXPLAIN_RATE_LIMIT_PER_MIN=12
MAX_BODY_BYTES=2000000

# --- Content and feedback ---
FEEDBACK_URL=                     # https://github.com/<you>/<repo>/issues/new  (enables "Report a problem" links)
CONTACT_EMAIL=                    # shown on the /privacy page
MAX_OUTCOMES_PER_LEARNER=20       # exam / practice-assessment results one learner can report

# --- Operations ---
LOG_LEVEL=INFO
LOG_JSON=false                    # true = one JSON object per line (the Docker image defaults to true)
ENABLE_DEMO=true
